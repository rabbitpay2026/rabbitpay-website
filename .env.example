# ---------------------------------------------------------------------------
# RabbitPay — Next.js environment
#
# Copy to `.env.local` for local development (`.env*` is gitignored).
# On AWS Amplify set these under App settings -> Environment variables.
#
# SECURITY
#   Variables prefixed NEXT_PUBLIC_ are inlined into the browser bundle and are
#   readable by anyone who loads the site. Everything else stays server-side.
#   NEVER add NEXT_PUBLIC_ to RESEND_API_KEY, and never commit a real key.
# ---------------------------------------------------------------------------

# === SERVER-ONLY — never exposed to the browser ============================

# Resend API key, used by /api/leads to send the lead notification.
# Read only in src/lib/email/resend.ts, which is marked `server-only`.
# Rotate in the Resend dashboard; set the value in Amplify, not in git.
RESEND_API_KEY=

# Inbox that receives lead notifications.
EMAIL_TO=avijeetdey.email@gmail.com

# Notification sender. MUST be an address on a domain verified in Resend —
# an unverified sender is rejected by the API and no mail is delivered.
# e.g. RabbitPay <hello@rabbitpay.ai>  (verify rabbitpay.ai in Resend first)
EMAIL_FROM=

# Only needed if Calendly webhooks are added later. Not used today.
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- Documentation ---------------------------------------------------------
# The Mintlify deployment that /documentation proxies. Defaults to
# https://docs.rabbitpay.ai when unset, which is correct for production — set it
# only to point a preview build at a different docs deployment.
#
# Server-only on purpose: it is the ONLY origin the proxy will fetch from
# (`lib/documentation/upstream.ts` refuses anything that does not resolve onto
# it), so it must not be settable from the browser. Give it the full base URL,
# including any subdirectory the docs are served under — not just the host.
DOCS_UPSTREAM_URL=


# === PUBLIC — inlined into the browser bundle at build time ================

# --- Analytics (public identifiers, not secrets) ---------------------------
# Leave a value empty to stop that script loading at all.

# Plausible site domain. Defaults to rabbitpay.ai when unset.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=rabbitpay.ai

# PostHog project. Defaults to the key the production site already ships.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Google Analytics 4 ----------------------------------------------------
# The GA4 measurement ID for rabbitpay.ai. A measurement ID is a public
# identifier — it appears in the page source of every GA4 site — so NEXT_PUBLIC_
# is the correct prefix and there is nothing here to keep secret. It is not an
# API secret and grants no write access.
#
# Leave it empty and GA4 is completely inert: no gtag.js request, no events, no
# errors. That is the intended state for forks and for local work you do not
# want in the production property.
#
# IMPORTANT for deploys: NEXT_PUBLIC_* values are inlined into the browser
# bundle at BUILD time, so this must be set in Amplify -> App settings ->
# Environment variables (applied to the branch) BEFORE the build runs. Unlike
# RESEND_API_KEY and friends, writing it to .env.production during the build
# would be too late — see the comments in amplify.yml.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-6RQ63F8KDN

# Former name for the same value, still read as a fallback so an environment
# that already sets it keeps working. Prefer NEXT_PUBLIC_GA_MEASUREMENT_ID.
NEXT_PUBLIC_GA4_ID=
